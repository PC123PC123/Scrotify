import 'package:http/http.dart' as http;
import 'package:crypto/crypto.dart';
import 'dart:convert';

class AuthService {
  final String _baseUrl;
  final String _username;
  final String _password;

  // Cache de sesión
  String? _sessionId;
  DateTime? _sessionExpiry;

  AuthService({
    required String baseUrl,
    required String username,
    required String password,
  })  : _baseUrl = baseUrl.replaceAll('/api', ''),
        _username = username,
        _password = password {

    // Intentar recuperar sesión existente
    final sessionFile = SessionCache().get();
    if (sessionFile != null) {
      final data = jsonDecode(sessionFile);
      _sessionId = data['sessionId'];
      _sessionExpiry = DateTime.parse(data['expiry']);

      if (_sessionExpiry?.isBefore(DateTime.now()) ?? true) {
        await _authenticate();
      }
    }
  }

  /// Autenticar con la API Subsonic
  Future<Map<String, dynamic>> authenticate() async {
    try {
      // Generar timestamp y nonce para seguridad
      final timestamp = DateTime.now().millisecondsSinceEpoch.toString();
      final nonce = generateNonce();

      // Crear credentials hash (SHA-256)
      final credentialsHash = sha256.convert(utf8.encode('$_username:$_password')).toString();

      // Construir URL de autenticación
      final authUrl = '$_baseUrl/auth';

      final response = await http.post(
        Uri.parse(authUrl),
        headers: {
          'Content-Type': 'application/json',
          'User-Agent': 'NavidromeClient/1.0 (Flutter; Linux)',
        },
        body: jsonEncode({
          'u': _username,
          'p': credentialsHash,
          'v': '1.16.0', // Versión de la API Subsonic
          't': timestamp,
          'n': nonce,
        }),
      );

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);

        if (data['status'] == 'ok') {
          // Guardar sesión en caché
          await SessionCache().save({
            'sessionId': data['sid'],
            'expiry': DateTime.now().add(Duration(hours: 24)).toIso8601String(),
          });

          _sessionId = data['sid'];
          return {
            'success': true,
            'sessionId': data['sid'],
            'status': data['status'],
          };
        } else {
          throw Exception('Autenticación fallida: ${data['status']}');
        }
      } else {
        throw Exception('Error de red: ${response.statusCode}');
      }
    } catch (e) {
      print('Error en autenticación: $e');
      rethrow;
    }
  }

  /// Verificar estado del servidor (ping)
  Future<Map<String, dynamic>> ping() async {
    try {
      final response = await http.get(
        Uri.parse('$_baseUrl/ping'),
        headers: _getHeaders(),
      );

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);

        if (data['status'] == 'ok') {
          return {
            'success': true,
            'serverVersion': data['v'],
            'status': data['status'],
            'hostname': data['h'],
          };
        } else {
          throw Exception('Ping fallido: ${data['status']}');
        }
      } else {
        throw Exception('Error al conectar con el servidor: ${response.statusCode}');
      }
    } catch (e) {
      print('Error en ping: $e');
      rethrow;
    }
  }

  /// Obtener carpetas de música
  Future<Map<String, dynamic>> getMusicFolders() async {
    try {
      final response = await http.get(
        Uri.parse('$_baseUrl/getMusicFolders'),
        headers: _getHeaders(),
      );

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);

        if (data['status'] == 'ok') {
          return {
            'success': true,
            'folders': data['f'],
            'status': data['status'],
          };
        } else {
          throw Exception('Error al obtener carpetas: ${data['status']}');
        }
      } else {
        throw Exception('Error al obtener carpetas: ${response.statusCode}');
      }
    } catch (e) {
      print('Error en getMusicFolders: $e');
      rethrow;
    }
  }

  /// Obtener lista de canciones (para probar conexión)
  Future<Map<String, dynamic>> getTracks(String folderId) async {
    try {
      final response = await http.get(
        Uri.parse('$_baseUrl/getTrackList'),
        headers: _getHeaders(),
        queryParameters: {
          'folder': folderId,
          'limit': '10',
          'n': 'true', // Nombres completos
        },
      );

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);

        if (data['status'] == 'ok') {
          return {
            'success': true,
            'tracks': data['t'],
            'count': data['c'],
            'status': data['status'],
          };
        } else {
          throw Exception('Error al obtener tracks: ${data['status']}');
        }
      } else {
        throw Exception('Error al obtener tracks: ${response.statusCode}');
      }
    } catch (e) {
      print('Error en getTracks: $e');
      rethrow;
    }
  }

  /// Headers con sesión
  Map<String, String> _getHeaders() {
    final headers = {
      'Content-Type': 'application/json',
      'User-Agent': 'NavidromeClient/1.0 (Flutter; Linux)',
    };

    if (_sessionId != null) {
      headers['Authorization'] = 'sid=$_sessionId';
    }

    return headers;
  }

  /// Generar nonce aleatorio
  String generateNonce() {
    final random = Random.secure();
    final bytes = List.generate(16, (i) => random.nextInt(256));
    return base64Encode(bytes).replaceAll('=', '');
  }
}

